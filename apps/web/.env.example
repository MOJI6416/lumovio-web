# Copy to apps/web/.env.local.
# Where `next dev` proxies /api/* (browser requests). In production the reverse proxy routes /api instead.
API_PROXY_TARGET=http://localhost:4000
# Where server components call the API directly (inside Docker: http://lumovio-api:4000).
API_INTERNAL_URL=http://localhost:4000
# Canonical origin for metadata, sitemap and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production only: hosts that 308-redirect to SITE_URL (e.g. www and a former domain), comma separated.
# REDIRECT_HOSTS=
