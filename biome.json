{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "files": {
    "includes": ["**", "!**/node_modules", "!**/.next", "!**/dist", "!**/drizzle", "!**/*.gen.ts", "!**/public/sw.js", "!**/playwright-report", "!**/test-results"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always" } },
  "linter": {
    "rules": {
      "recommended": true,
      "a11y": { "recommended": true },
      "suspicious": { "noExplicitAny": "warn" },
      "style": { "noNonNullAssertion": "off" }
    }
  },
  "css": { "parser": { "tailwindDirectives": true } },
  "overrides": [
    {
      "includes": ["apps/web/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/sources", "**/sources/**", "**/tmdb", "**/fanart", "**/wikidata", "**/tvmaze", "**/anilist", "**/mdblist", "**/omdb"],
                    "message": "The site reads Lumovio's own API: the catalog's sources are asked by its import alone."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
